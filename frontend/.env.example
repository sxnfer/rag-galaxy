# Copy to .env.production (or set these in your build pipeline).
# Where the API lives once deployed (no trailing slash). Leave empty in development: Vite forwards /api.
VITE_API_URL=
# The site's public address, used for link previews (og:image needs a full URL).
VITE_SITE_URL=
# The commit being deployed, so the journey's links to the code point at the exact version that is running
# (e.g. the output of `git rev-parse HEAD`). Left empty, the links point at the main branch.
VITE_COMMIT=
