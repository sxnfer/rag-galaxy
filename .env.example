# Copy to .env (never commit .env).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Which chunks the app searches in a library of PDFs: the "active run". (A table library always uses cards/0.)
RUN_CHUNKER=fixed
RUN_SIZE=300
# Uncomment to test without downloading the real model (keyword-like, tests only):
# RAG_FAKE_EMBEDDER=1
# Public-demo protection (per server process). The example questions are pre-computed and never count.
RATE_PER_MINUTE=4
RATE_PER_DAY=30
DAILY_AI_BUDGET=500
# How many proxies of our own sit in front of the API. 0 locally. 1 on Azure Container Apps, so the
# rate limiter reads the visitor's real address from the proxy and not one the visitor typed.
TRUSTED_PROXIES=0
# The site's address(es), comma-separated, allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173
